#!/usr/bin/env bash
# Emit a bounded, newest-first view of Crew Chief's local session spool.
#
# This program is intentionally a separate executable so Quickshell's Process
# can pass directory and adapter paths as argv. Do not fold it into `bash -c`
# in Panel.qml: shell interpolation there made ordinary apostrophes in HOME
# break the refresh command.
set -euo pipefail

spool_dir="${1:-}"
adapter="${2:-}"
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
spool_helper="$self_dir/crew-chief-spool"
[[ -x "$spool_helper" ]] || exit 1

if [[ -n "$adapter" && -x "$adapter" ]]; then
  "$adapter" 2>/dev/null || true
fi

# secure-state pins the private parent, bounds the census before sorting,
# opens files once with O_NOFOLLOW|O_NONBLOCK, and verifies object identity.
exec "$spool_helper" list "$spool_dir"
