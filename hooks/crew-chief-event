#!/bin/bash
# Crew Chief spool writer — wired into Claude Code as a hook command.
#
# Claude Code invokes hooks with a JSON payload on stdin (session_id, cwd,
# hook_event_name, message, ...). Each event updates one small JSON file per
# session under the spool dir; the Crew Chief bar widget watches that dir.
# The optional message is persisted locally. Reporters must provide only a
# short attention headline, never a secret or transcript excerpt.
#
# Install (adds entries to ~/.claude/settings.json): hooks/install-claude-hooks
set -euo pipefail

SPOOL="${CREW_CHIEF_SPOOL:-}"
SPOOL_HELPER="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/crew-chief-spool"
[[ -x $SPOOL_HELPER ]] || exit 0

payload="$(head -c 16385)"
[[ ${#payload} -le 16384 ]] || exit 0

session_id=$(timeout 2 jq -r '.session_id // empty' <<<"$payload" 2>/dev/null) || exit 0
[[ $session_id =~ ^[A-Za-z0-9._-]{1,128}$ ]] || exit 0
event=$(timeout 2 jq -r '.hook_event_name // empty' <<<"$payload" 2>/dev/null) || exit 0
cwd=$(timeout 2 jq -r '.cwd // empty' <<<"$payload" 2>/dev/null) || exit 0
message=$(timeout 2 jq -r '.message // empty' <<<"$payload" 2>/dev/null) || exit 0

case "$event" in
  SessionEnd)
    "$SPOOL_HELPER" remove "$SPOOL" "$session_id"
    exit 0
    ;;
  Notification)
    state="needs_you"
    ;;
  Stop)
    state="done"
    message=""
    ;;
  SubagentStop)
    state="working"
    message=""
    ;;
  SessionStart|UserPromptSubmit|PreCompact|*)
    state="working"
    message=""
    ;;
esac

# The secure-state helper pins the parent directory, keeps an exclusive
# O_NOFOLLOW temporary descriptor through fsync, and publishes atomically.
jq -cn \
  --arg id "$session_id" \
  --arg state "$state" \
  --arg cwd "$cwd" \
  --arg agent "claude-code" \
  --arg message "$message" \
  --argjson ts "$(date +%s%3N)" \
  '{id:$id, state:$state, cwd:$cwd, agent:$agent, message:$message, ts:$ts}' \
  | "$SPOOL_HELPER" write "$SPOOL" "$session_id"
